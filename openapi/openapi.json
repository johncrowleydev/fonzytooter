{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/ErrorModel.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Event": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "type": {
            "enum": [
              "text_delta",
              "tool_started",
              "tool_completed",
              "citation",
              "usage",
              "completed",
              "error"
            ],
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "Execution": {
        "additionalProperties": false,
        "properties": {
          "failed": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "passed": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "summary": {
            "maxLength": 1000,
            "type": "string"
          }
        },
        "required": [
          "passed",
          "failed"
        ],
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/Health.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "LessonResource": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/LessonResource.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "content": {
            "description": "Raw MDX source body with YAML frontmatter removed.",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "moduleId": {
            "type": "string"
          },
          "objectiveIds": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceResource"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "moduleId",
          "title",
          "objectiveIds",
          "sources",
          "content"
        ],
        "type": "object"
      },
      "LessonSummary": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "objectiveIds": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "objectiveIds"
        ],
        "type": "object"
      },
      "ModuleResource": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/ModuleResource.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "lessons": {
            "items": {
              "$ref": "#/components/schemas/LessonSummary"
            },
            "type": "array"
          },
          "objectives": {
            "items": {
              "$ref": "#/components/schemas/ObjectiveResource"
            },
            "type": "array"
          },
          "order": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "videos": {
            "items": {
              "$ref": "#/components/schemas/VideoResource"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "title",
          "order",
          "objectives",
          "videos",
          "lessons"
        ],
        "type": "object"
      },
      "ModuleSummary": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "order": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "order"
        ],
        "type": "object"
      },
      "ModuleSummaryList": {
        "items": {
          "$ref": "#/components/schemas/ModuleSummary"
        },
        "type": "array"
      },
      "ObjectiveResource": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "prerequisites": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "prerequisites"
        ],
        "type": "object"
      },
      "PageContext": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 30000,
            "type": "string"
          },
          "exerciseId": {
            "maxLength": 200,
            "type": "string"
          },
          "exerciseTitle": {
            "maxLength": 300,
            "type": "string"
          },
          "lastExecution": {
            "$ref": "#/components/schemas/Execution"
          },
          "lessonId": {
            "maxLength": 200,
            "type": "string"
          },
          "lessonTitle": {
            "maxLength": 300,
            "type": "string"
          },
          "moduleId": {
            "maxLength": 200,
            "type": "string"
          },
          "moduleTitle": {
            "maxLength": 300,
            "type": "string"
          },
          "objectiveId": {
            "maxLength": 200,
            "type": "string"
          },
          "objectiveIds": {
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "type": [
              "array",
              "null"
            ]
          },
          "objectiveTitle": {
            "maxLength": 300,
            "type": "string"
          },
          "projectId": {
            "maxLength": 200,
            "type": "string"
          },
          "projectTitle": {
            "maxLength": 300,
            "type": "string"
          },
          "sectionId": {
            "maxLength": 200,
            "type": "string"
          },
          "selectedText": {
            "maxLength": 10000,
            "type": "string"
          },
          "title": {
            "maxLength": 300,
            "type": "string"
          },
          "type": {
            "enum": [
              "dashboard",
              "curriculum",
              "lesson",
              "exercise",
              "review",
              "progress",
              "project"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "SourceResource": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "url"
        ],
        "type": "object"
      },
      "TurnRequest": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/TurnRequest.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "conversationId": {
            "maxLength": 200,
            "type": "string"
          },
          "message": {
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "[^\\s]",
            "patternDescription": "contain at least one non-whitespace character",
            "type": "string"
          },
          "mode": {
            "enum": [
              "explain",
              "socratic",
              "exercise",
              "quiz",
              "explore"
            ],
            "type": "string"
          },
          "pageContext": {
            "$ref": "#/components/schemas/PageContext"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "Usage": {
        "additionalProperties": false,
        "properties": {
          "inputTokens": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "outputTokens": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "totalTokens": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "VideoResource": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "objectiveIds": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "objectiveIds"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Fonzytooter API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get API health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/modules": {
      "get": {
        "operationId": "listModules",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleSummaryList"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List curriculum modules",
        "tags": [
          "curriculum"
        ]
      }
    },
    "/api/modules/{moduleId}": {
      "get": {
        "operationId": "getModule",
        "parameters": [
          {
            "in": "path",
            "name": "moduleId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleResource"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Get a curriculum module",
        "tags": [
          "curriculum"
        ]
      }
    },
    "/api/modules/{moduleId}/lessons/{lessonId}": {
      "get": {
        "operationId": "getLesson",
        "parameters": [
          {
            "in": "path",
            "name": "moduleId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "lessonId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonResource"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Get a curriculum lesson",
        "tags": [
          "curriculum"
        ]
      }
    },
    "/api/tutor/turns": {
      "post": {
        "operationId": "createTutorTurn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TurnRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "description": "Each item describes one possible Server-Sent Event message serialized as UTF-8 text.",
                  "items": {
                    "$ref": "#/components/schemas/Event"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Gateway"
          }
        },
        "summary": "Create a tutor turn and stream its events",
        "tags": [
          "tutor"
        ]
      }
    }
  }
}
