{
  "name": "fonzytooter-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:check": "node scripts/check-api-boundaries.mjs",
    "api:generate": "orval --config orval.config.ts && node scripts/enforce-generated-json-validation.mjs",
    "api:test": "node --test scripts/check-api-boundaries.test.mjs scripts/runtime-validation.test.mjs scripts/worksheet-workbooks.test.mjs",
    "curriculum:mdx": "node scripts/validate-curriculum-mdx.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@tanstack/react-query": "^5.101.4",
    "codemirror": "6.0.2",
    "katex": "^0.16.22",
    "pyodide": "314.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "29.0.1",
    "orval": "^8.24.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0",
    "vitest": "4.1.11"
  }
}
