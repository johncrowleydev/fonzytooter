{
  "name": "fonzytooter-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:check": "node scripts/check-api-boundaries.mjs",
    "api:generate": "orval --config orval.config.ts",
    "api:test": "node --test scripts/check-api-boundaries.test.mjs scripts/runtime-validation.test.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "orval": "^8.24.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-compiler-api": "npm:typescript@5.9.3",
    "vite": "^8.2.0"
  }
}
