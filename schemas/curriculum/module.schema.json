{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Code generated by server/cmd/curriculum-schema; DO NOT EDIT.",
  "$ref": "#/$defs/ModuleAuthoring",
  "$defs": {
    "ModuleAuthoring": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable module ID within the owning course.",
          "type": "string"
        },
        "lessons": {
          "description": "Canonical ordered list of lesson IDs in this module.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "objectives": {
          "description": "Learning objectives introduced by this module.",
          "items": {
            "$ref": "#/$defs/ObjectiveAuthoring"
          },
          "type": "array"
        },
        "order": {
          "description": "Non-negative module display order within the course.",
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "title": {
          "description": "Module title shown to the learner.",
          "type": "string"
        },
        "videos": {
          "description": "Curated videos associated with this module.",
          "items": {
            "$ref": "#/$defs/VideoAuthoring"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "order"
      ],
      "title": "Fonzytooter module metadata",
      "type": "object"
    },
    "ObjectiveAuthoring": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "Description of the capability represented by this objective.",
          "type": "string"
        },
        "id": {
          "description": "Stable globally unique learning-objective ID.",
          "type": "string"
        },
        "prerequisites": {
          "description": "Objective IDs that should be learned first.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "title": {
          "description": "Short learner-facing objective title.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "description"
      ],
      "type": "object"
    },
    "VideoAuthoring": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable video ID within this module.",
          "type": "string"
        },
        "objectiveIds": {
          "description": "Objective IDs supported by this video.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "title": {
          "description": "Video title shown to the learner.",
          "type": "string"
        },
        "url": {
          "description": "HTTP or HTTPS URL for the video.",
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "url"
      ],
      "type": "object"
    }
  }
}
