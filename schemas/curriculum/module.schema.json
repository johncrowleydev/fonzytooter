{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Code generated by server/cmd/curriculum-schema; DO NOT EDIT.",
  "$ref": "#/$defs/ModuleAuthoring",
  "$defs": {
    "ModuleAuthoring": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable module ID within the owning course.",
          "type": "string"
        },
        "lessons": {
          "description": "Canonical ordered list of lesson IDs in this module.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "objectives": {
          "description": "Learning objectives introduced by this module.",
          "items": {
            "$ref": "#/$defs/ObjectiveAuthoring"
          },
          "type": "array"
        },
        "order": {
          "description": "Non-negative module display order within the course.",
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "title": {
          "description": "Module title shown to the learner.",
          "type": "string"
        },
        "videos": {
          "description": "Curated videos associated with this module.",
          "items": {
            "$ref": "#/$defs/VideoAuthoring"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "order"
      ],
      "title": "Helix Academy module metadata",
      "type": "object"
    },
    "ObjectiveAuthoring": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "Description of the capability represented by this objective.",
          "type": "string"
        },
        "id": {
          "description": "Stable globally unique learning-objective ID.",
          "type": "string"
        },
        "prerequisites": {
          "description": "Objective IDs that should be learned first.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "title": {
          "description": "Short learner-facing objective title.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "description"
      ],
      "type": "object"
    },
    "VideoAuthoring": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "description": "Authored YouTube channel or creator name.",
          "type": "string"
        },
        "durationMinutes": {
          "description": "Approximate authored duration in whole minutes.",
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "description": "Stable video ID within this module.",
          "type": "string"
        },
        "lessonIds": {
          "description": "Lesson IDs in this module associated with this video.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "objectiveIds": {
          "description": "Objective IDs owned by this module and supported by this video.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "order": {
          "description": "Canonical non-negative playlist order within this module.",
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "title": {
          "description": "Video title shown to the learner.",
          "type": "string"
        },
        "youtubeId": {
          "description": "The 11-character YouTube video ID, not a URL or embed markup.",
          "pattern": "^[A-Za-z0-9_-]{11}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "youtubeId",
        "title",
        "channel",
        "durationMinutes",
        "order",
        "objectiveIds"
      ],
      "type": "object"
    }
  }
}
