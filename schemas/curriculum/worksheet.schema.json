{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Code generated by server/cmd/curriculum-schema; DO NOT EDIT.",
  "$ref": "#/$defs/WorksheetAuthoring",
  "$defs": {
    "WorksheetAuthoring": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable worksheet ID within the owning module.",
          "type": "string"
        },
        "instructions": {
          "description": "Learner-facing worksheet instructions.",
          "type": "string"
        },
        "lessonId": {
          "description": "ID of the lesson that owns this worksheet.",
          "type": "string"
        },
        "objectiveIds": {
          "description": "Objective IDs assessed by this worksheet.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "order": {
          "description": "Non-negative worksheet order within its lesson.",
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "problems": {
          "description": "Problems included in this worksheet.",
          "items": {
            "$ref": "#/$defs/WorksheetProblemAuthoring"
          },
          "minItems": 1,
          "type": "array"
        },
        "title": {
          "description": "Worksheet title shown to the learner.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "lessonId",
        "order",
        "objectiveIds",
        "instructions",
        "problems"
      ],
      "title": "Fonzytooter worksheet",
      "type": "object"
    },
    "WorksheetProblemAuthoring": {
      "additionalProperties": false,
      "properties": {
        "expectedAnswer": {
          "description": "Authored expected answer used by solution material.",
          "type": "string"
        },
        "id": {
          "description": "Stable problem ID within this worksheet.",
          "type": "string"
        },
        "objectiveIds": {
          "description": "Objective IDs assessed by this problem.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "prompt": {
          "description": "Learner-facing problem prompt.",
          "type": "string"
        },
        "requiresWork": {
          "description": "Whether the learner should show intermediate work.",
          "type": "boolean"
        },
        "responseLines": {
          "description": "Positive number of response lines to render.",
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "rubric": {
          "description": "Criteria used to evaluate the response.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "id",
        "prompt",
        "objectiveIds",
        "expectedAnswer",
        "requiresWork",
        "responseLines",
        "rubric"
      ],
      "type": "object"
    }
  }
}
