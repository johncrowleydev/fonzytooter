HELIX_ACADEMY_ADDR=:8080
HELIX_ACADEMY_DB_PATH=./data/helix-academy.db
HELIX_ACADEMY_CURRICULUM_PATH=../curriculum
# Configure both values to provision the durable owner account. Keep the real
# password in the deployment environment, never in this file or Git.
HELIX_ACADEMY_AUTH_USERNAME=
HELIX_ACADEMY_AUTH_PASSWORD=
HELIX_ACADEMY_AUTH_DISPLAY_NAME=Owner
HELIX_ACADEMY_AUTH_SECURE_COOKIE=true
HELIX_ACADEMY_AUTH_SESSION_TTL=24h
# Tutor access is denied unless both entitlement and a positive monthly turn
# allowance are configured. A reserved turn remains counted if its provider call fails.
HELIX_ACADEMY_TUTOR_ENTITLED=false
HELIX_ACADEMY_TUTOR_MONTHLY_TURN_LIMIT=0
OPENROUTER_API_KEY=
HELIX_ACADEMY_TUTOR_MODEL=
