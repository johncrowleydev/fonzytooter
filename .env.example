FONZYTOOTER_ADDR=:8080
FONZYTOOTER_DB_PATH=./data/fonzytooter.db
FONZYTOOTER_CURRICULUM_PATH=../curriculum
# Configure both values to provision the durable owner account. Keep the real
# password in the deployment environment, never in this file or Git.
FONZYTOOTER_AUTH_USERNAME=
FONZYTOOTER_AUTH_PASSWORD=
FONZYTOOTER_AUTH_DISPLAY_NAME=Owner
FONZYTOOTER_AUTH_SECURE_COOKIE=true
FONZYTOOTER_AUTH_SESSION_TTL=24h
OPENROUTER_API_KEY=
